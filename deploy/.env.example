# Docker Compose 部署配置样例
# 复制为 .env 并填写实际值（切勿将真实 .env 提交到版本库）

# === 安全 ===
# JWT 密钥 (必填, 必须替换为强随机值)
# 生成命令: python -c "import secrets; print(secrets.token_hex(32))"
# 注意: 下面的占位值已被列入弱密钥黑名单, 直接照抄会导致服务启动失败 (fail-closed 设计)
#       生产环境还要求密钥长度 >= 32 字符
JWT_SECRET_KEY=change-me-in-production

# CORS 允许的前端来源 (JSON 数组格式, 不要使用 *)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# === PostgreSQL ===
POSTGRES_DB=exam_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production

# === MiniMax AI API (用于 AI 出题和知识点智能提取) ===
# 从 MiniMax 控制台获取: https://platform.minimaxi.com/
MINIMAX_API_KEY=your-minimax-api-key

# === 可观测性 (可选) ===
# Sentry 错误追踪: 留空则不启用; 从 https://sentry.io 项目设置中获取 DSN
SENTRY_DSN=
# 运行环境标识 (development / staging / production)
ENVIRONMENT=production
# 结构化 JSON 日志 (便于日志采集器解析), 生产建议 true
LOG_JSON=true
