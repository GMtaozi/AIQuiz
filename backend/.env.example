# AI 题库管理系统配置文件
# 复制此文件为 .env 并填写实际值

# JWT 密钥 (必需, 生产环境必须替换为强随机值)
# 生成命令: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here

# 数据库 (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_question_bank

# CORS 允许的前端来源 (JSON 数组格式, 不要使用 *)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# MiniMax AI API (用于 AI 出题和知识点智能提取)
# 从 MiniMax 控制台获取: https://platform.minimaxi.com/
MINIMAX_API_KEY=your-minimax-api-key-here
MINIMAX_GROUP_ID=your-minimax-group-id-here

# 调试模式
DEBUG=true

# API 文档开关 (生产环境保持 false; 本地开发设为 true 可访问 /docs 和 /redoc)
ENABLE_DOCS=true
